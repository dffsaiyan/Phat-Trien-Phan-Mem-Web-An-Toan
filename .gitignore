# Dependencies
**/vendor/
**/node_modules/
npm-debug.log
yarn-error.log

# Laravel local storage and cache
**/bootstrap/cache/*.php
**/storage/framework/cache/*
!**/storage/framework/cache/.gitignore
**/storage/framework/sessions/*
!**/storage/framework/sessions/.gitignore
**/storage/framework/views/*
!**/storage/framework/views/.gitignore
**/storage/logs/*
!**/storage/logs/.gitignore
**/public/hot
**/public/storage

# Environment local files
.env
DDH-Electronics/.env
*vnpayAccount.txt

# Large archives and presentation slides (avoid GitHub 100MB limit and keep repo fast)
*.zip
*.pptx

